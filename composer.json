{
    "name": "laravelplus/sitemap",
    "description": "A comprehensive Laravel package for sitemap management with route discovery, status checking, and environment-specific features",
    "keywords": [
        "laravel",
        "sitemap",
        "routes",
        "status-check",
        "monitoring"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "LaravelPlus Team",
            "email": "team@laravelplus.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.0",
        "spatie/laravel-permission": "^5.0|^6.0",
        "spatie/laravel-sluggable": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelPlus\\Sitemap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelPlus\\Sitemap\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelPlus\\Sitemap\\Providers\\SitemapServiceProvider"
            ],
            "aliases": {
                "Sitemap": "LaravelPlus\\Sitemap\\SitemapFacade"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
} 