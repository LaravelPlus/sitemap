{
    "name": "laravelplus/sitemap",
    "description": "XML sitemap built from your app's own routes, plus whatever dynamic URLs you register.",
    "keywords": [
        "laravel",
        "sitemap",
        "seo"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "LaravelPlus Team",
            "email": "team@laravelplus.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelPlus\\Sitemap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelPlus\\Sitemap\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelPlus\\Sitemap\\SitemapServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
